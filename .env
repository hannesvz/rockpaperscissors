# Streaming Configuration - reads from system environment variables
YOUTUBE_ENABLED=false
YOUTUBE_STREAM_KEY=${YOUTUBE_STREAM_KEY}

TWITCH_ENABLED=true
TWITCH_STREAM_KEY=${TWITCH_STREAM_KEY}

# Stream settings
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30

# Test mode - saves to output.mp4 instead of streaming
TEST_MODE=false
